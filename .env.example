# ==============================================================================
# SpecRAG: Zero-Cost Multi-Provider LLM Configuration
# ==============================================================================
# At least ONE of the following API keys is required for LLM generation/eval.
# All options below offer generous free tiers.

# Primary Choice (Fastest inference ~500 tok/s):
GROQ_API_KEY=gsk_...

# NVIDIA NIM (Experience with enterprise NIM microservices):
NVIDIA_API_KEY=nvapi-...

# OpenRouter Free Tier (Access to free :free models like meta-llama/llama-3.3-70b-instruct:free):
OPENROUTER_API_KEY=sk-or-v1-...

# GitHub Models (Free access to gpt-4o-mini, llama-3.1 via GitHub Personal Access Token):
GITHUB_TOKEN=ghp_...

# Google Gemini (Free tier):
GEMINI_API_KEY=AIzaSy...

# Local Ollama Base URL (if running locally without any external API keys):
OLLAMA_BASE_URL=http://localhost:11434/v1

# Preferred LLM Provider (groq | nvidia | openrouter | github | gemini | ollama | auto)
SPECRAG_LLM_PROVIDER=auto

# Qdrant Local Storage Path
QDRANT_STORAGE_PATH=./qdrant_db

# Embedding Model (BAAI/bge-small-en-v1.5 runs fast on CPU)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Reranker Model (BAAI/bge-reranker-base on CPU, bge-reranker-large on GPU)
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

